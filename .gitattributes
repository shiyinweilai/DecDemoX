# 静态库按二进制处理，避免 Git 做换行符转换或合并
*.a      binary
*.dylib  binary
*.so     binary
*.framework/** binary

# Xcode 工程文件：保持原样，不做换行符归一化
*.pbxproj   text eol=lf
*.xcscheme  text eol=lf
*.xcconfig  text eol=lf
*.plist     text eol=lf
*.storyboard text eol=lf
*.xib       text eol=lf

# 用于 GitHub 语言统计时排除第三方/生成文件
*.a linguist-vendored
include/av1d/** linguist-vendored

# auto generated by UGit 
*.a filter=lfs diff=lfs merge=binary -text
*.pbxproj filter=lfs diff=lfs merge=binary -text

