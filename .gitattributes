# ============================================
# Git LFS — 静态库与 Xcode 工程文件走 LFS
# ============================================
*.a         filter=lfs diff=lfs merge=binary -text
*.pbxproj   filter=lfs diff=lfs merge=binary -text

# 测试码流体积大且不可压缩，走 LFS 避免仓库膨胀
*.stream filter=lfs diff=lfs merge=binary -text
*.ivf    filter=lfs diff=lfs merge=binary -text
*.obu    filter=lfs diff=lfs merge=binary -text

# ============================================
# 其他二进制文件
# ============================================
*.dylib  binary
*.so     binary
*.framework/** binary

# ============================================
# 文本文件 — 统一 LF 换行
# ============================================
*.c          text eol=lf
*.h          text eol=lf
*.m          text eol=lf
*.mm         text eol=lf
*.md         text eol=lf
*.json       text eol=lf
*.yaml       text eol=lf
*.yml        text eol=lf
*.sh         text eol=lf
*.xcscheme   text eol=lf
*.xcconfig   text eol=lf
*.plist      text eol=lf
*.storyboard text eol=lf
*.xib        text eol=lf

# ============================================
# GitHub 语言统计 — 排除第三方解码库源码
# ============================================
**/include/txav1d/** linguist-vendored
**/libtxav1d_arm64/** linguist-vendored
